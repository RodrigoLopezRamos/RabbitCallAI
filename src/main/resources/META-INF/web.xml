    <filter-mapping>
        <filter-name>ClientFilter</filter-name>
        <url-pattern>*.s</url-pattern>
        <url-pattern>*.n</url-pattern>
        <url-pattern>*.a</url-pattern>
        <url-pattern>*.c</url-pattern>
        <url-pattern>*.v</url-pattern>
        <url-pattern>/mediaServlet.m/*</url-pattern>
        <url-pattern>/publicMediaServlet.a/*</url-pattern>
    </filter-mapping>

    <filter-mapping>
        <filter-name>LogFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>


    <filter-mapping>
        <filter-name>DeviceFilter</filter-name>
        <url-pattern>*.s</url-pattern>
        <url-pattern>*.n</url-pattern>
    </filter-mapping>

    <filter-mapping>
        <filter-name>RequestAuthenticationFilter</filter-name>
        <url-pattern>*.s</url-pattern>
        <url-pattern>*.a</url-pattern>
        <url-pattern>*.v</url-pattern>
        <url-pattern>/mediaServlet.m/*</url-pattern>
        <url-pattern>/publicMediaServlet.a/*</url-pattern>
    </filter-mapping>

    <filter-mapping>
        <filter-name>RequestAuthorizationFilter</filter-name>
        <url-pattern>*.s</url-pattern>
<!--        <url-pattern>*.c</url-pattern>-->
        <url-pattern>*.a</url-pattern>
        <url-pattern>*.v</url-pattern>

    </filter-mapping>

    <filter-mapping>
        <filter-name>VendorAuthenticationFilter</filter-name>
        <url-pattern>*.v</url-pattern>
    </filter-mapping>

    <filter-mapping>
        <filter-name>DeviceLocationFilter</filter-name>
        <url-pattern>/rs/trade/all.s</url-pattern>
        <url-pattern>/rs/voucher/all.s</url-pattern>
        <url-pattern>/rs/metadata/create-review.s</url-pattern>
        <url-pattern>/rs/metadata/create-review.s</url-pattern>
        <url-pattern>/rs/social/story/save.s</url-pattern>

    </filter-mapping>

</web-app>