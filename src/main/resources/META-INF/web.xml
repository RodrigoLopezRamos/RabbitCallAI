         version="3.0">
    <display-name>AnaliaWebServices</display-name>


    <servlet>
        <servlet-name>MediaServlet</servlet-name>
        <servlet-class>com.analia.web.media.MediaServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>PublicMediaServlet</servlet-name>
        <servlet-class>com.analia.web.media.PublicMediaServlet</servlet-class>
    </servlet>

