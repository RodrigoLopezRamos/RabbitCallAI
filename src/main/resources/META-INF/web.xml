    <servlet-mapping>
        <servlet-name>MediaServlet</servlet-name>
        <url-pattern>/mediaServlet.m/*</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>PublicMediaServlet</servlet-name>
        <url-pattern>/publicMediaServlet.a/*</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>PublicMediaServlet</servlet-name>
        <url-pattern>/publicmedia/*</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>AuthorizedMediaServlet</servlet-name>
        <url-pattern>/authmedia.u</url-pattern>
        <url-pattern>/authmedia.u/*</url-pattern>
    </servlet-mapping>

    <context-param>
        <param-name>javax.ws.rs.Application</param-name>
        <param-value>com.analia.web.AnaliaApplication</param-value>
    </context-param>

